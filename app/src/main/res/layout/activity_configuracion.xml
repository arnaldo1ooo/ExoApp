<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_app"
    android:fitsSystemWindows="true"
    tools:context=".ActivityConfiguracion">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/ancho_max_contenido">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla_h"
            android:paddingTop="@dimen/margen_pantalla_v"
            android:paddingEnd="@dimen/margen_pantalla_h"
            android:paddingBottom="@dimen/margen_pantalla_v">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cfg_apariencia"
                android:textColor="@color/texto_principal"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/cfg_apariencia_desc"
                android:textColor="@color/texto_secundario"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/rgTema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbTemaSistema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/opcion_tema_fondo"
                android:buttonTint="@color/acento"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:text="@string/cfg_tema_sistema"
                android:textColor="@color/texto_principal"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbTemaClaro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/opcion_tema_fondo"
                android:buttonTint="@color/acento"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:text="@string/cfg_tema_claro"
                android:textColor="@color/texto_principal"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbTemaOscuro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/opcion_tema_fondo"
                android:buttonTint="@color/acento"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:text="@string/cfg_tema_oscuro"
                android:textColor="@color/texto_principal"
                android:textSize="16sp" />

            </RadioGroup>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
