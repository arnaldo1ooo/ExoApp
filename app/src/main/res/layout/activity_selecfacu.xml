<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearLayout3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_app"
    android:fitsSystemWindows="true"
    tools:context=".ActivitySelecfacultad">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla_h"
        android:layout_marginTop="@dimen/margen_pantalla_v"
        android:layout_marginEnd="@dimen/margen_pantalla_h"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="Facultades de la Universidad Ejemplo"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintTop_toTopOf="parent"
        ads:layout_constraintWidth_max="@dimen/ancho_max_contenido" />

    <TextView
        android:id="@+id/textView50"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla_h"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/margen_pantalla_h"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="Seleccione su facultad"
        android:textColor="#FAFAFA"
        android:textSize="18sp"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintTop_toBottomOf="@+id/tvTitulo"
        ads:layout_constraintWidth_max="@dimen/ancho_max_contenido" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPrincipal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margen_pantalla_h"
        android:paddingEnd="@dimen/margen_pantalla_h"
        android:paddingBottom="12dp"
        ads:layout_constraintBottom_toTopOf="@+id/adView1"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintTop_toBottomOf="@+id/textView50"
        ads:layout_constraintWidth_max="@dimen/ancho_max_contenido" />

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-8474453660271942/9184800934"
        ads:layout_constraintBottom_toBottomOf="parent"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
