<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_app"
    android:fitsSystemWindows="true"
    tools:context="com.exoapp.ActivityTipoEvalu">

    <!-- Contenido con scroll y ancho maximo: nunca se recorta y en tablets queda centrado -->
    <ScrollView
        android:id="@+id/scrollTipoEvalu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/tvVersionApp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/ancho_max_contenido">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla_h"
            android:paddingTop="@dimen/margen_pantalla_v"
            android:paddingEnd="@dimen/margen_pantalla_h"
            android:paddingBottom="@dimen/margen_pantalla_v">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/seleccione_el_tipo_de_evaluaci_n"
                android:textColor="@color/texto_principal"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnopc1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/boton_borde_redondo"
                android:minHeight="@dimen/alto_minimo_boton"
                android:soundEffectsEnabled="false"
                android:text="@string/_15_15_10"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:textSize="26sp" />

            <Button
                android:id="@+id/btnopc2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/boton_borde_redondo"
                android:minHeight="@dimen/alto_minimo_boton"
                android:soundEffectsEnabled="false"
                android:text="@string/_20_20_0"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:textSize="26sp" />

            <Button
                android:id="@+id/btnopc3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/boton_borde_redondo"
                android:minHeight="@dimen/alto_minimo_boton"
                android:text="@string/_10_10_20"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:textSize="26sp" />

            <Button
                android:id="@+id/btnopc4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/boton_borde_redondo"
                android:minHeight="@dimen/alto_minimo_boton"
                android:text="@string/_15_20_5"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:textSize="26sp" />

            <Button
                android:id="@+id/btnopc5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/boton_borde_redondo"
                android:minHeight="@dimen/alto_minimo_boton"
                android:text="@string/_10_20_5"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:textSize="26sp" />

            <Button
                android:id="@+id/btnopc6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/boton_borde_redondo"
                android:minHeight="@dimen/alto_minimo_boton"
                android:text="@string/_15_20_10"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal"
                android:textSize="26sp" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvVersionApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/tv_versionapp"
        android:textColor="@color/texto_tenue"
        android:textSize="12sp"
        ads:layout_constraintBottom_toTopOf="@+id/adView1"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="parent" />

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-8474453660271942/9184800934"
        ads:layout_constraintBottom_toBottomOf="parent"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
