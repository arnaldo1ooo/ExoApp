<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_app"
    android:fitsSystemWindows="true"
    tools:context=".conversion.ActivityConversion">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/adViewConversion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/ancho_max_contenido">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla_h"
            android:paddingTop="@dimen/margen_pantalla_v"
            android:paddingEnd="@dimen/margen_pantalla_h"
            android:paddingBottom="@dimen/margen_pantalla_v">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.1"
                android:text="@string/conv_intro"
                android:textColor="@color/texto_secundario"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/rgModo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbPuntoAPorc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/segmento_izq"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:text="@string/conv_modo_puntos_a_porc"
                    android:textColor="@color/segmento_texto"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbPorcAPunto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/segmento_der"
                    android:button="@null"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:text="@string/conv_modo_porc_a_puntos"
                    android:textColor="@color/segmento_texto"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvEjemploConver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/conv_ejemplo_puntos_a_porc"
                android:textColor="@color/texto_tenue"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTituloTotalConver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/conv_total_titulo"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etTotalValor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#FFFFFF"
                    android:gravity="end|center_vertical"
                    android:hint="@string/conv_total_hint"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:minHeight="52dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#959595"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvTotalValorUnidad"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/conv_unidad_puntos"
                    android:textColor="@color/texto_secundario"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTituloValorObte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/conv_obtenido_puntos_titulo"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etValorObte"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#FFFFFF"
                    android:gravity="end|center_vertical"
                    android:hint="@string/conv_obtenido_puntos_hint"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:minHeight="52dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#959595"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvValorObteUnidad"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/conv_unidad_puntos"
                    android:textColor="@color/texto_secundario"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAvisoConver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/error_suave"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/tarjeta_resultado"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/conv_resultado_titulo"
                    android:textAllCaps="true"
                    android:textColor="@color/acento"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResultadoConver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="44sp"
                    app:autoSizeMinTextSize="20sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/tvDetalleConver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/conv_completa"
                    android:textColor="@color/texto_secundario"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.gms.ads.AdView
        android:id="@+id/adViewConversion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-8474453660271942/9184800934"
        ads:layout_constraintBottom_toBottomOf="parent"
        ads:layout_constraintEnd_toEndOf="parent"
        ads:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
